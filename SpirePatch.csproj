<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net9.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AssemblyName>SpirePatch</AssemblyName>
    <Version>0.14.3</Version><InformationalVersion>0.14.3</InformationalVersion><IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion><ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.7" />
  </ItemGroup>
  <ItemGroup>
    <!-- Keep the standalone console probe isolated from the WPF application's default compile glob. -->
    <Compile Remove="tools/**/*.cs" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="catalog-plan.json" /><EmbeddedResource Include="patch-catalog.json" /><EmbeddedResource Include="InstallerBridge.ps1" /><EmbeddedResource Include="SelectionBridge.ps1" /><EmbeddedResource Include="ManagerUpdateWorker.ps1" /></ItemGroup>
</Project>
