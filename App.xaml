<Application x:Class="SpirePatch.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Bg" Color="#0D1524"/><SolidColorBrush x:Key="Panel" Color="#D9182942"/>
  <SolidColorBrush x:Key="Line" Color="#344862"/><SolidColorBrush x:Key="Ink" Color="#F0F5FC"/>
  <SolidColorBrush x:Key="Muted" Color="#CBD8E9"/><SolidColorBrush x:Key="Gold" Color="#83B9F8"/>
  <Style TargetType="Window"><Setter Property="Background" Value="#152238"/><Setter Property="Foreground" Value="#F0F5FC"/><Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/></Style>
  <Style TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <!-- Rounded borders must be anti-aliased in fractional DPI layouts. Avoid hard opaque
       1px outlines and shadows over the text; use low-alpha strokes instead. -->
  <!-- WPF's default dotted keyboard focus rectangle looks harsh on glass.
       Replace it with a rounded focus adorner, visible for keyboard navigation. -->
  <Style x:Key="SoftFocusVisual" TargetType="{x:Type Control}">
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="{x:Type Control}">
     <Border Margin="-2" BorderBrush="#A8A8D2FF" BorderThickness="1.5" CornerRadius="11" SnapsToDevicePixels="False" UseLayoutRounding="False" IsHitTestVisible="False"/>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="#B42C425E"/><Setter Property="BorderBrush" Value="#397D9BC1"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,10"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource SoftFocusVisual}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="False" UseLayoutRounding="False" RenderOptions.EdgeMode="Unspecified">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                       SnapsToDevicePixels="True"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True">
      <Setter TargetName="B" Property="BorderBrush" Value="#648FB6E2"/>
     </Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True">
      <Setter TargetName="B" Property="BorderBrush" Value="#B0A7D3FF"/>
     </Trigger>
     <Trigger Property="IsEnabled" Value="False">
      <Setter TargetName="B" Property="Opacity" Value="0.68"/>
     </Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#83B9F8"/><Setter Property="Foreground" Value="#10243F"/>
   <Setter Property="BorderBrush" Value="#408AB8ED"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#942C4363"/><Setter Property="Foreground" Value="#F0F5FC"/>
   <Setter Property="BorderBrush" Value="#327995BA"/>
  </Style>
  <!-- Navigation is not a stack of outlined buttons: only the active entry gets a
       translucent fill and a narrow left accent. The shared keyboard focus remains. -->
  <Style x:Key="NavItem" TargetType="Button" BasedOn="{StaticResource Ghost}">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="3,0,0,0"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border x:Name="NavSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"
             SnapsToDevicePixels="False" UseLayoutRounding="False">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                        SnapsToDevicePixels="True"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="NavSurface" Property="Background" Value="#56344F71"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter TargetName="NavSurface" Property="Opacity" Value=".68"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <!-- Tabs and filters indicate selection without competing with the one primary action. -->
  <Style x:Key="SelectedTab" TargetType="Button" BasedOn="{StaticResource Ghost}">
   <Setter Property="Background" Value="#76446993"/>
   <Setter Property="BorderBrush" Value="#5A90B7E1"/>
   <Setter Property="Foreground" Value="#EAF4FF"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="#E01B2E4A"/><Setter Property="BorderBrush" Value="#577B9DBB"/><Setter Property="CaretBrush" Value="#83B9F8"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" SnapsToDevicePixels="False" UseLayoutRounding="False"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#83B9F8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#F0F5FC"/><Setter Property="Background" Value="#D0263A55"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F0F5FC"/><Setter Property="Background" Value="#22344D"/></Style>
  <Style TargetType="ListBox"><Setter Property="Foreground" Value="#F0F5FC"/><Setter Property="Background" Value="#E01B2E4A"/></Style>
  <Style TargetType="ContextMenu"><Setter Property="Background" Value="#22344D"/><Setter Property="Foreground" Value="#F0F5FC"/></Style>
  <Style TargetType="MenuItem"><Setter Property="Foreground" Value="#F0F5FC"/><Setter Property="Background" Value="#22344D"/></Style>
  <!-- Card-local glass controls: rounded hit area, translucent low-contrast strokes.
       Do not change checkboxes in installation or patch-selection workflows. -->
  <Style x:Key="ModCardCheckBox" TargetType="CheckBox">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="Margin" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource SoftFocusVisual}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Grid MinHeight="30" SnapsToDevicePixels="False">
     <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border x:Name="TickSurface" Width="19" Height="19" HorizontalAlignment="Left" VerticalAlignment="Center"
       CornerRadius="6" Background="#7040526E" BorderBrush="#548EADD1" BorderThickness="1"
       SnapsToDevicePixels="False" UseLayoutRounding="False"/>
     <Path x:Name="TickMark" HorizontalAlignment="Left" VerticalAlignment="Center"
       Data="M 4,10 L 8,14 L 15,6" Stroke="#F0F7FF" StrokeThickness="2.1"
       StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
       Visibility="Collapsed" IsHitTestVisible="False"/>
     <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True">
      <Setter TargetName="TickSurface" Property="Background" Value="#87506B8B"/>
      <Setter TargetName="TickSurface" Property="BorderBrush" Value="#7789B9E5"/>
     </Trigger>
     <Trigger Property="IsChecked" Value="True">
      <Setter TargetName="TickSurface" Property="Background" Value="#BC47769C"/>
      <Setter TargetName="TickSurface" Property="BorderBrush" Value="#9EA6D5F2"/>
      <Setter TargetName="TickMark" Property="Visibility" Value="Visible"/>
     </Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TickSurface" Property="Opacity" Value=".5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ModCardAction" TargetType="Button" BasedOn="{StaticResource Ghost}">
   <Setter Property="Background" Value="#6B344C67"/><Setter Property="BorderBrush" Value="#2E85A4C7"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="FocusVisualStyle" Value="{StaticResource SoftFocusVisual}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11"
      Padding="{TemplateBinding Padding}" SnapsToDevicePixels="False" UseLayoutRounding="False"
      RenderOptions.EdgeMode="Unspecified">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
        VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True">
      <Setter TargetName="Surface" Property="Background" Value="#8B466480"/>
      <Setter TargetName="Surface" Property="BorderBrush" Value="#558BB8DD"/>
     </Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#B7446788"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".55"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,8"/></Style>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Padding" Value="0,8"/></Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="8"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
     <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#6687AA" CornerRadius="4" Margin="2,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
    </Track>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- v0.14 workspace: navigation is a text tab, not a raised button. -->
  <Style x:Key="ModWorkspaceTab" TargetType="Button">
   <Setter Property="Foreground" Value="#ACC2D9"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Normal"/>
   <Setter Property="Padding" Value="12,12,12,13"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource SoftFocusVisual}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid>
     <Border x:Name="TabSurface" Background="{TemplateBinding Background}" CornerRadius="7,7,0,0">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
     </Border>
     <Border Height="2" VerticalAlignment="Bottom" Background="{TemplateBinding BorderBrush}" CornerRadius="1"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#33415C79"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TabSurface" Property="Opacity" Value=".5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ModWorkspaceTabActive" TargetType="Button" BasedOn="{StaticResource ModWorkspaceTab}">
   <Setter Property="Foreground" Value="#F1F7FF"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="BorderBrush" Value="#86B9F4"/>
  </Style>
  <!-- Quiet toolbar: icons and labels without heavy full outlines. -->
  <Style x:Key="ModToolbarAction" TargetType="Button">
   <Setter Property="Foreground" Value="#CFDDEC"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="10,8"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource SoftFocusVisual}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="ToolbarSurface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToolbarSurface" Property="Background" Value="#52466783"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="ToolbarSurface" Property="Background" Value="#765779A0"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ToolbarSurface" Property="Opacity" Value=".45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ModToolbarPrimary" TargetType="Button" BasedOn="{StaticResource ModToolbarAction}">
   <Setter Property="Foreground" Value="#F5F9FF"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Background" Value="#6742638A"/>
  </Style>
  <!-- Only the selected segment is filled; unselected choices remain flat. -->
  <Style x:Key="ModSegment" TargetType="Button" BasedOn="{StaticResource ModToolbarAction}">
   <Setter Property="Foreground" Value="#AEC2D9"/><Setter Property="Padding" Value="13,7"/>
  </Style>
  <Style x:Key="ModSegmentActive" TargetType="Button" BasedOn="{StaticResource ModSegment}">
   <Setter Property="Background" Value="#75517598"/><Setter Property="Foreground" Value="#F5F9FF"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
 </Application.Resources>
</Application>
