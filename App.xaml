<Application x:Class="SpirePatch.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Bg" Color="#0D1524"/><SolidColorBrush x:Key="Panel" Color="#DF182942"/>
  <SolidColorBrush x:Key="Line" Color="#344862"/><SolidColorBrush x:Key="Ink" Color="#F0F5FC"/>
  <SolidColorBrush x:Key="Muted" Color="#CBD8E9"/><SolidColorBrush x:Key="Gold" Color="#83B9F8"/>
  <Style TargetType="Window"><Setter Property="Background" Value="#152238"/><Setter Property="Foreground" Value="#F0F5FC"/><Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/></Style>
  <Style TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="#22344D"/><Setter Property="BorderBrush" Value="#405876"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,10"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#739BCB"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#83B9F8"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.55"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#83B9F8"/><Setter Property="Foreground" Value="#10243F"/><Setter Property="BorderBrush" Value="#83B9F8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#20314A"/><Setter Property="Foreground" Value="#F0F5FC"/><Setter Property="BorderBrush" Value="#405876"/></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="#182942"/><Setter Property="BorderBrush" Value="#5B789B"/><Setter Property="CaretBrush" Value="#83B9F8"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#83B9F8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#F0F5FC"/><Setter Property="Background" Value="#22344D"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F0F5FC"/><Setter Property="Background" Value="#22344D"/></Style>
  <Style TargetType="ListBox"><Setter Property="Foreground" Value="#F0F5FC"/><Setter Property="Background" Value="#182942"/></Style>
  <Style TargetType="ContextMenu"><Setter Property="Background" Value="#22344D"/><Setter Property="Foreground" Value="#F0F5FC"/></Style>
  <Style TargetType="MenuItem"><Setter Property="Foreground" Value="#F0F5FC"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,8"/></Style>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Padding" Value="0,8"/></Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="8"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
     <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#6687AA" CornerRadius="4" Margin="2,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
    </Track>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Application.Resources>
</Application>
